# Mẫu biến môi trường cho docker-compose.yml ở thư mục gốc.
# Cách nhanh nhất: `sh scripts/init-env.sh` tự sinh .env với mọi giá trị ngẫu nhiên.
# Hoặc sao chép thành .env rồi thay MỌI giá trị bằng chuỗi ngẫu nhiên mới (không commit .env).
# Sinh tay (Git Bash):
#   openssl rand -base64 32        -> JWT_SECRET, LAB_JWT_SECRET
#   openssl rand -hex 24           -> các mật khẩu (48 ký tự)

# Tài khoản quản trị PostgreSQL: chỉ dùng để chạy script khởi tạo, backend KHÔNG dùng tài khoản này.
DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD

# Tài khoản ứng dụng (Least Privilege), do database/init/02-least-privilege.sql tạo.
# Mật khẩu tối thiểu 24 ký tự, nếu ngắn hơn script 02 sẽ dừng và backend không đăng nhập được DB.
APP_DB_USERNAME=app_user
APP_DB_PASSWORD=CHANGE_ME_RANDOM_APP_PASSWORD_AT_LEAST_24_CHARS

# Khóa ký JWT dùng chung cho 2 node backend prod: Base64 của ít nhất 32 byte ngẫu nhiên.
JWT_SECRET=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

# Chế độ WAF không còn đặt qua .env: prod luôn On; chỉ listener lab đổi tạm cho Demo 3
# bằng sh scripts/waf-mode.sh lab DetectionOnly|On.

# Tồn dư (R-RES-01): database prod vẫn chạy 04-sqli-demo.sh nên vẫn cần biến này,
# dù node prod không còn dùng tài khoản sqli_demo_reader.
SQLI_LAB_READER_PASSWORD=CHANGE_ME_RANDOM_LAB_READER_PASSWORD

# Chỉ đổi cổng, không đổi địa chỉ bind 127.0.0.1.
HTTPS_PORT=443

# ---- Lab tách biệt (profile lab: lab-db + lab-backend, listener https://localhost:9443) ----
# Khóa JWT của lab: PHẢI khác JWT_SECRET để token lab không được prod chấp nhận.
LAB_JWT_SECRET=REPLACE_WITH_DIFFERENT_BASE64_OF_32_RANDOM_BYTES
LAB_DB_ADMIN_PASSWORD=CHANGE_ME_RANDOM_LAB_ADMIN_PASSWORD
LAB_APP_DB_PASSWORD=CHANGE_ME_RANDOM_LAB_APP_PASSWORD_AT_LEAST_24_CHARS
LAB_SQLI_READER_PASSWORD=CHANGE_ME_RANDOM_LAB_SQLI_READER_PASSWORD
LAB_HTTPS_PORT=9443
