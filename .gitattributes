# File được mount/chạy trong container Linux phải giữ LF kể cả khi clone trên Windows
# (psql đọc sai meta-command như \getenv, \if nếu dòng kết thúc bằng CRLF).
*.sh   text eol=lf
*.sql  text eol=lf
*.conf text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
# Git hook chạy bằng sh (không có đuôi .sh): giữ LF trên mọi hệ điều hành.
.githooks/* text eol=lf
# Request thô cho Burp giữ nguyên CRLF như giao thức HTTP
*.http -text
